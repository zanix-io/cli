{
  "name": "@zanix/cli",
  "version": "2.2.0-rc.5",
  "license": "MIT",
  "nodeModulesDir": "auto",
  // Governs resolution of THIS package's own dependencies (e.g. `@zanix/server`, imported by
  // `commands/space/dev/action.ts`) — a structurally separate graph from a served project's own
  // config, which has no effect here. Without this, Deno's default freshness window silently
  // excludes an already-published `@zanix/server` version from resolution.
  "minimumDependencyAge": 0,
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true
  },
  "publish": {
    "exclude": [".github", "src/@tests", "scripts", "docs/engineering.md"]
  },
  "exports": {
    ".": "./mod.ts",
    // The sole installer, cross-platform (`src/installation/setup.ts`). A real, published export
    // — not just an internal file — so `deno run -A jsr:@zanix/cli@[version]/setup` resolves
    // without hardcoding JSR's own CDN URL structure. `publish.exclude` below must never cover
    // `src/installation`, or `deno publish` refuses to ship this declared export.
    "./setup": "./src/installation/setup.ts"
  },
  "tasks": {
    "znx": "deno run -A mod.ts",
    "build": "deno task znx build",
    "new": "deno task znx new",
    "generate": "deno task znx generate",
    "prepare": "deno task znx prepare -g -e",
    // Routes through this package's own real installer (`src/installation/setup.ts`, `--local`
    // mode) instead of a standalone `deno install` line — a real, confirmed gap this replaced: the
    // old standalone line installed straight from `./mod.ts` and never went through JSR at all, so
    // it could never exercise (or catch a regression in) the code path a real end-user's `deno run
    // -A jsr:@zanix/cli check-cycles`/`deno install -g jsr:@zanix/cli` actually goes through —
    // including `deno install -g`'s own dynamic-import dependency-locking gap `setup.ts` already
    // handles (only packages reachable from `mod.ts`'s STATIC import graph get resolved/locked at
    // install time; every command whose real body lives in a dynamically-imported `action.ts`, this
    // repo's own lazy-dispatch pattern, resolves fresh at runtime instead, hitting Deno's default
    // 24h minimum-dependency-age policy regardless of what was passed at install time — `setup.ts`
    // fixes this by syncing this checkout's own complete `deno.lock` into the installed shim's).
    "cli:install": "deno run -A ./src/installation/setup.ts --local",
    "cli:uninstall": "deno uninstall -g zanix"
  },
  "exclude": ["**/__tmp__/**"],
  "lint": {
    "rules": {
      "tags": ["recommended", "jsr"],
      "include": [
        "eqeqeq",
        "default-param-last",
        "camelcase",
        "no-await-in-loop",
        "no-const-assign",
        "no-eval",
        "no-non-null-asserted-optional-chain",
        "no-non-null-assertion",
        "no-self-compare",
        "no-sync-fn-in-async-fn",
        "no-throw-literal",
        "no-useless-rename"
      ]
    },
    // `src/installation/` (`setup.ts`) is a standalone bootstrap script — it runs BEFORE `zanix`
    // itself is installed, so it structurally cannot depend on the Zanix `logger` module
    // `no-znx-console` (part of the plugin below) would otherwise require; plain `console.log` is
    // the correct choice there, not a violation to fix.
    "exclude": [".dist/", "__tmp__", "src/installation/"],
    "plugins": ["jsr:@zanix/utils@^4.2.1/linter/deno-zanix-plugin"],
    "report": "pretty"
  },
  "fmt": {
    "exclude": [".dist/", "**/__tmp__/**"],
    "proseWrap": "preserve",
    "indentWidth": 2,
    "singleQuote": true,
    "lineWidth": 100,
    "useTabs": false,
    "semiColons": false
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@0.224",
    "@std/testing": "jsr:@std/testing@1.0.9",
    "@cliffy/command": "jsr:@cliffy/command@1.2.1",
    // `@zanix/utils`-derived entries (this block) and `@zanix/auth`/`@zanix/datamaster`/
    // `@zanix/notifications` further below are the AMBIENT-fallback pins `native-runtime-
    // modules.ts`'s own `runExternalModule` (`@zanix/space`) falls back to whenever `resolveDenoAt`
    // can't resolve a served project's own bare `@zanix/*` import against that project's config —
    // a real, confirmed gap, not a theoretical one: reproduced live serving a consumer project (a
    // Deno WORKSPACE MEMBER with no `deno.lock` of its own — the lock lives at the workspace root) under
    // `zanix space dev`. That project's own `require-session.ts` (reached from a route's `@Guard`,
    // through this exact ambient path) throws a real `HttpError('UNAUTHORIZED')`; `@zanix/auth`'s
    // own `redirectUnauthenticatedPageVisit` — loaded via THIS shim's stale `@zanix/auth@^1.2.1`/
    // `@zanix/utils@^4.2.1` pins instead of the served project's own newer `^1.4.1`/`^4.5.0` — held
    // a genuinely different `HttpError` class than the one the project's own code threw with, so its
    // `error instanceof HttpError` check silently declined every time: a guarded page's `401` fell
    // through to a raw JSON body instead of a login redirect, under `zanix space dev` ONLY (never in
    // production, where a plain `deno run mod.ts` has no ambient-fallback path to diverge through at
    // all). Confirmed the same repro redirects correctly once these entries are bumped to match, and
    // breaks again reverted to the stale ones. These pins going stale relative to a real served
    // project's own (newer) versions is the ENTIRE failure mode — keep them current, not just at
    // publish time: a served project bumping `@zanix/auth`/`@zanix/datamaster`/`@zanix/notifications`
    // past whatever this file happens to declare silently reopens this exact class of bug for
    // anything reached through the ambient fallback, with no error, no warning, just a class that
    // quietly stops matching. See `native-runtime-modules.ts`'s own doc for why `resolveDenoAt`
    // doesn't always avoid this fallback for a workspace-member project with no lockfile of its own —
    // a real, currently-unresolved structural gap this pin bump only mitigates, not closes.
    "@zanix/utils": "jsr:@zanix/utils@^4.5.0",
    "@zanix/logger": "jsr:@zanix/utils@^4.5.0/logger",
    "@zanix/logger/client": "jsr:@zanix/utils@^4.5.0/logger/client",
    "@zanix/helpers": "jsr:@zanix/utils@^4.5.0/helpers",
    "@zanix/types": "jsr:@zanix/utils@^4.5.0/types",
    "@zanix/errors": "jsr:@zanix/utils@^4.5.0/errors",
    "@zanix/utils/workers": "jsr:@zanix/utils@^4.5.0/workers",
    "@zanix/utils/regex": "jsr:@zanix/utils@^4.5.0/regex",
    "@zanix/server": "jsr:@zanix/server@^4.2.1",
    "@zanix/server/graphql": "jsr:@zanix/server@^4.2.1/graphql",
    // Powers `import-project-module.ts`'s own resolution of a CONSUMING project's own bare
    // specifiers against ITS nearest `deno.json(c)`, never `cli`'s — see that module's own doc.
    // Already a real, working transitive dependency (pulled in via `@deno/vite-plugin`); declared
    // directly here because this package also imports it directly, on its own terms.
    "@deno/loader": "jsr:@deno/loader@^0.5.0",
    // Real JS lexer `import-project-module.ts` uses to find a transpiled file's own import/export
    // specifiers precisely — the same one Vite/Rollup use internally for this exact job. See that
    // module's own doc for why a hand-rolled regex/comment scanner isn't good enough here.
    "es-module-lexer": "npm:es-module-lexer@^1.5.4",
    // Same native-runtime-module identity reason `@zanix/auth`'s own entry documents further below
    // (`imports` block) — `native-runtime-modules.ts` (`@zanix/space`) lists `@zanix/asyncmq`
    // alongside `@zanix/auth`/`@zanix/datamaster`/`@zanix/notifications` as sharing the identical
    // DI-container identity split; this entry is what already closes that gap for this package.
    "@zanix/asyncmq": "jsr:@zanix/asyncmq@^0.8.0",
    "@zanix/asyncmq/jobs": "jsr:@zanix/asyncmq@^0.8.0/jobs",
    // `zanix space dev` (`dev/action.ts`) needs `Zanix.compose()` for a `space-server` project —
    // the real registration step (`defineCoreMetadata()` + auto-discovered `src/server/` handlers)
    // its own boot sequence never got, having dropped to `activateApps`/`bootstrapServers` directly
    // instead of the project's real `mod.ts`'s `Zanix.start()`. See that call site's own doc for
    // the full mechanism and the real "Missing core connector slot" failure this prevents.
    "@zanix/core": "jsr:@zanix/core@^3.1.1",
    "@zanix/app": "jsr:@zanix/app@^1.0.2",
    "@zanix/app/runtime": "jsr:@zanix/app@^1.0.2/runtime",
    "@zanix/space": "jsr:@zanix/space@^1.6.0",
    "@zanix/space/vite": "jsr:@zanix/space@^1.6.0/vite",
    "@zanix/space/dev": "jsr:@zanix/space@^1.6.0/dev",
    "@zanix/space/testing": "jsr:@zanix/space@^1.6.0/testing",
    "@zanix/space/assets-manifest": "jsr:@zanix/space@^1.6.0/assets-manifest",
    "@zanix/space/comet": "jsr:@zanix/space@^1.6.0/comet",
    "@zanix/space/client": "jsr:@zanix/space@^1.6.0/client",
    "@zanix/space/client/preact": "jsr:@zanix/space@^1.6.0/client/preact",
    "@zanix/space/react": "jsr:@zanix/space@^1.6.0/react",
    "@zanix/space/preact": "jsr:@zanix/space@^1.6.0/preact",
    // Floor bumped to `^2.0.0` for the `Menu`/`NavDrawer` breaking change (`Menu` drops its
    // `@zanix/space` dependency and moves from `./runtime` to the default entrypoint; `image` is
    // replaced by `visual`) — published, `deno.lock` regenerated against the real release
    // (confirmed via a full `deno test` run, not just `deno check`, so every dynamically-imported
    // command's own dependency stayed pinned too).
    "@zanix/space-ui": "jsr:@zanix/space-ui@^2.0.0",
    "@zanix/space-ui/preact": "jsr:@zanix/space-ui@^2.0.0/preact",
    "@zanix/space-ui/runtime": "jsr:@zanix/space-ui@^2.0.0/runtime",
    "@zanix/space-ui/runtime/preact": "jsr:@zanix/space-ui@^2.0.0/runtime/preact",
    // The one real ICU dependency this package owns — `@zanix/space` itself never depends on this
    // (see `compile-messages.ts`'s own module doc). Same version `@zanix/space-ui` pins for its own
    // (type-only) reference to `MessageFormatElement`, kept in sync deliberately, not by accident.
    "@formatjs/icu-messageformat-parser": "npm:@formatjs/icu-messageformat-parser@^3.5.17",
    // The one real `graphql-js` dependency this package owns — `graphql-check.ts`'s own Layer 1
    // syntax check (`parse()`) and Layer 2 schema check (`validate()`). Reached only through
    // `action.ts`'s own already-lazy import chain (see `graphql-check.ts`'s own module doc), the
    // same reachability shape `@formatjs/icu-messageformat-parser` above already relies on — never a
    // cost paid by any `zanix` invocation outside `space build`/`space dev` with a real `gql/`
    // directory present.
    "graphql": "npm:graphql@^16",
    // Same reason as `preact`/`preact/hooks` below: `zanix space dev` resolves a scaffolded
    // project's own dependencies against THIS config, not the project's own `deno.json` (see the
    // `@zanix/cli cannot honor that link` warning `dev-engine.ts`'s own fallback logs) — a
    // `--renderer react` project's routes/Comets import `react`/`react-dom` directly, and without
    // these declared HERE too, `zanix space dev` fails the moment it tries to resolve them.
    // `command.test.ts`'s in-process `space build` integration tests reuse THIS repo's own
    // `node_modules` too, so this must be declared here regardless, not only in
    // `THIRD_PARTY_DEPENDENCY_VERSIONS` (which covers what a freshly generated project gets).
    "react": "npm:react@^19.2.0",
    "react-dom": "npm:react-dom@^19.2.0",
    // `react`'s own subpath doesn't auto-expand just because the bare package name above is
    // aliased: `deno run --config <this file>` (the exact shape `zanix space dev`'s own
    // `RealImportEvaluator.runExternalModule`
    // (`ssr-module-evaluator.ts`, `@zanix/space`) uses for a real, Vite-transformed SSR module,
    // written to and natively imported from a plain OS temp dir) fails `Import
    // "react/jsx-dev-runtime" not a dependency` even with `"react"` declared above — Deno's own
    // import-map resolution doesn't auto-expand a bare (non-`/`-suffixed) alias entry's subpaths
    // the way `@deno/loader`'s own `resolveSync` does, so every subpath actually reached needs
    // its own explicit entry here, same as every other subpath already declared throughout this
    // file (`preact/hooks`, `@prefresh/core`, `@zanix/space/dev`, ...). Vite's own React SSR dev
    // transform ALWAYS injects a literal `import {jsxDEV} from 'react/jsx-dev-runtime'` (dev) /
    // `'react/jsx-runtime'` (prod) into every SSR-rendered React module, so a `--renderer react`
    // project fails this way on literally the FIRST real page render under `zanix space dev`.
    "react/jsx-runtime": "npm:react@^19.2.0/jsx-runtime",
    "react/jsx-dev-runtime": "npm:react@^19.2.0/jsx-dev-runtime",
    // `@zanix/space's own Vite build pipeline wires `@vitejs/plugin-react`'s `reactCompiler`
    // option (React Compiler support) — that plugin resolves this package by name from the
    // consuming project at build time; it is never bundled inside
    // `@vitejs/plugin-react` itself. Needed here for the same reason `react`/`react-dom` above
    // are: `command.test.ts`'s in-process `space build` integration tests reuse THIS repo's own
    // `node_modules`, not a scaffolded project's, so this must be declared here too, not only in
    // `THIRD_PARTY_DEPENDENCY_VERSIONS` (which covers what a freshly generated project gets).
    "babel-plugin-react-compiler": "npm:babel-plugin-react-compiler@^1.0.0",
    // `react`/`react-dom` ship no `.d.ts` of their own — needed so `command.test.ts`'s in-process
    // `space build` runs (reusing THIS repo's own `node_modules`) type-check cleanly against real
    // JSX/`Component` types, same reachability reason as `react`/`react-dom` above.
    "@types/react": "npm:@types/react@^19.2.0",
    "@types/react-dom": "npm:@types/react-dom@^19.2.0",
    // Same reason as `react`/`react-dom` above, for the OTHER renderer: `zanix space dev` resolves
    // a scaffolded project's own dependencies against THIS config, not the project's own
    // `deno.json` (see the `@zanix/cli cannot honor that link` warning `dev-engine.ts`'s own
    // fallback logs) — a `--renderer preact` project's Comets import `preact`/`preact/hooks`
    // directly (`--theme astronaut`'s own demo uses the latter), and without these declared HERE
    // too, `zanix space dev` fails outright with "not a dependency and not in import map" the
    // moment it tries to resolve them, regardless of what the scaffolded project's own `deno.json`
    // says. Same versions `THIRD_PARTY_DEPENDENCY_VERSIONS` (`cli`'s own
    // `dependencies.ts`) already pins for what a freshly generated project gets.
    "preact": "npm:preact@^10.29.0",
    "preact/hooks": "npm:preact@^10.29.0/hooks",
    // Same real bug as `react/jsx-runtime`/`react/jsx-dev-runtime` above, for the OTHER renderer:
    // Vite's own Preact SSR dev transform injects a literal `import {jsxDEV} from
    // 'preact/jsx-dev-runtime'` into every SSR-rendered Preact module, natively imported by
    // `RealImportEvaluator.runExternalModule` (`@zanix/space`) against THIS config — without an
    // explicit entry, a `--renderer preact` project fails the identical way on its first real page
    // render.
    "preact/jsx-runtime": "npm:preact@^10.29.0/jsx-runtime",
    "preact/jsx-dev-runtime": "npm:preact@^10.29.0/jsx-dev-runtime",
    // Same reason as `preact`/`preact/hooks` above: `space-plugin.ts`'s own `optimizeDeps.include`
    // (preact branch) names both, and `zanix space dev` needs a real, top-level
    // `node_modules/@prefresh/*` entry to resolve them — without this declared HERE too, Vite's own
    // dep optimizer fails with "Failed to resolve dependency: @prefresh/core" the moment it tries.
    // This fixes a real correctness bug, not just a discovery-scan race: two different
    // `@prefresh/core` instances silently split Prefresh's own re-render tracking in two, making a
    // Comet's own Fast-Refresh update run with zero errors but never touch the DOM — see
    // `space-plugin.ts`'s own doc in `@zanix/space` for the full mechanism.
    "@prefresh/core": "npm:@prefresh/core@^1.5.10",
    "@prefresh/utils": "npm:@prefresh/utils@^1.2.1",
    // Needed for `@zanix/space`'s own `nativeRuntimeModulesPlugin` (`native-runtime-modules.ts`) to
    // resolve `@zanix/auth` at all, not for anything `cli` itself imports directly. That plugin
    // fixes a real module-identity split — a route's own `@Guard` bare-importing `@zanix/auth`
    // (e.g. `ctx.providers.get(ZanixAuthProvider)`, a real, documented pattern) otherwise gets a
    // SEPARATE, Vite-SSR-evaluated copy of the class than the one `space.app.ts`'s own native
    // `import '@zanix/auth/core'` registered DI metadata onto, throwing `[BaseInstancesContainer]:
    // Target is not a constructor` on every request even though `ctx.providers.get('auth')` (the
    // SAME provider, by string key) resolves fine — by routing the specifier through a real native
    // `import()` instead, sharing the SAME already-loaded instance. That native `import()` — like
    // every bare specifier for a running `zanix` process, regardless of which file/package issues
    // it — resolves against THIS config, never a scaffolded project's own `deno.json` (same
    // `preact`/`preact/hooks` reasoning above): without this entry, it fails outright with "not a
    // dependency and not in import map", turning the identity fix into a hard resolution failure
    // instead.
    "@zanix/auth": "jsr:@zanix/auth@^1.4.1",
    // `@zanix/datamaster` and `@zanix/notifications` need the identical entry, for the identical
    // reason as `@zanix/auth` immediately above — `native-runtime-modules.ts` (`@zanix/space`)
    // documents all three as sharing the exact same DI-container identity split (each package
    // registers its own `@Provider`-decorated class via a `./core` side-effect import, down to the
    // same doc comment verbatim — see that file's own header doc for the full mechanism). Without
    // these two specifically, `RealImportEvaluator.runExternalModule`'s plain native `import()`
    // (`ssr-module-evaluator.ts`, `@zanix/space`) has no entry to resolve either bare specifier
    // against at all — unlike `@zanix/auth` above, neither is declared here, so a route/guard file
    // reached through `zanix space dev`'s SSR pipeline that bare-imports either package fails
    // outright with "not a dependency and not in import map" the moment it does — a hard crash, not
    // the SAME-but-silent wrong-copy split `@zanix/auth`'s own entry above already prevents.
    "@zanix/datamaster": "jsr:@zanix/datamaster@^1.9.3",
    "@zanix/notifications": "jsr:@zanix/notifications@^1.2.3",
    // `@zanix/asyncmq` above (`imports` block, alongside `@zanix/asyncmq/jobs`) already closes this
    // identical gap for that package — declared for the same native-runtime-module identity reason
    // as `@zanix/auth`/`@zanix/datamaster`/`@zanix/notifications` here.
    "@std/path": "jsr:@std/path@0.224",
    "@std/fs": "jsr:@std/fs@1.0.24",
    "@std/jsonc": "jsr:@std/jsonc@1.0.2",
    // `promptSecret()` — `zanix credentials password-hash`'s own hidden, un-echoed password
    // input when no positional argument is given (`commands/credentials/password-hash/command.ts`).
    "@std/cli": "jsr:@std/cli@1.0.32",
    // `load()` — `zanix space dev`'s own `.env` loading (`commands/space/dev/action.ts`). Unlike
    // `start`/`worker` (plain `deno run --env-file=.env ...`), `zanix space dev` runs as a
    // subcommand of the already-started, globally-installed `zanix`/`znx` binary, so there's no
    // `deno run` invocation of the generated task itself to attach `--env-file` to; loading and
    // exporting `.env` in-process is the equivalent for this one task.
    "@std/dotenv": "jsr:@std/dotenv@0.225.8",
    "typings/": "./src/typings/",
    "shared/": "./src/shared/",
    "utils/": "./src/utils/",
    "modules/": "./src/modules/",
    "commands/": "./src/commands/",
    "cli": "./src/cli.ts"
  },
  "zanix": {
    "project": "library"
  },
  "test": {
    "include": [
      "src/@tests/**/*.test.ts",
      "scripts/**/*.test.ts"
    ]
  }
}
