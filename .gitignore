# Deno dependencies and caches
/vendor/

# Editor & system files
.DS_Store
.vscode/
Thumbs.db

# `unit/commands/prepare/main.test.ts` invokes `actionHandler` directly, which really runs each
# bound option's own action (e.g. `prepareDockerAction`) against `Deno.cwd()` — same real-side-
# effect reason `.vscode/` is already ignored above, now also true for `--docker`'s own output.
/Dockerfile
/.dockerignore

# Logs & debugging files
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build artifacts
/dist/
/.dist/
/out/

# Environment & config files
.env
.env.local

# Temporary files and folders
__tmp__/
*.tmp
*.log
/.logs/

# `native-dependency-freshness.ts`'s own generated artifacts — written straight into THIS checkout's
# own directory (never a served project's) whenever `zanix space dev`/`build` runs from a local
# `cli` checkout, since `locateCliLockPath` resolves to this repo's own `deno.lock` in that shape.
/.zanix-import-native-freshness-*.lock.json
/.zanix-native-freshness-cache.json

# `import-project-module.ts`'s own global generated-module-directory manifest
# (`recordGeneratedModuleDir`) — same "written straight into THIS checkout's own directory for a
# local `cli` checkout" shape as the two entries above, since `globalCliStateDir` resolves to this
# repo's own directory in that case.
/generated-module-dirs.json

# Compiled JavaScript files
tsconfig.tsbuildinfo

# Miscellaneous
node_modules/  # If using third-party tools that install node_modules

# Test coverage reports
/coverage/

# Node
node_modules