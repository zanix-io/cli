# Generated by `zanix prepare --docker`. Destination-agnostic packaging — this is one option among
# several (see DEPLOY.md); the real deploy artifact is always this project's own
# `${ENTRYPOINT_MODULE}` + the `${TASK_NAME}` task already declared in its `deno.json`.
#
# Shared by BOTH `'server'` (`mod.ts` + `start`) and `'app'` (`serve.ts` + `serve`) project types —
# a plain runnable Deno process, no special build step (unlike `dockerfile.space.base`, which
# additionally installs npm dependencies and builds a client bundle). The two never drift apart on
# anything but those two substituted values (see `docker-file.ts`'s own doc).
#
# GET /health and /ready are served automatically by `@zanix/server`'s `bootstrapServers` — see
# DEPLOY.md's "Health checks" section for probe examples (K8s httpGet, Docker HEALTHCHECK).

# ---- Build stage: cache dependencies as their own layer ----
FROM denoland/deno:${DENO_VERSION} AS build
WORKDIR /app
ENV DENO_DIR=/deno-dir

COPY deno.json* deno.lock* ./
RUN deno cache ${ENTRYPOINT_MODULE} || true

# ---- Runtime stage ----
FROM denoland/deno:${DENO_VERSION}
WORKDIR /app
ENV DENO_DIR=/deno-dir

COPY . .
COPY --from=build /deno-dir /deno-dir

EXPOSE ${PORT}

CMD ["task", "${TASK_NAME}"]
