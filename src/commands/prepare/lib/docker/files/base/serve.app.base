import app from './mod.ts'
import { bootstrapRemoteApp } from '@zanix/app/runtime'

/**
 * This app's own standalone remote entrypoint — generated by `zanix prepare --docker -p app`.
 * Bootstraps THIS app as its own standalone process: activates it, serves its operations/routes
 * over HTTP, and (if `remoteInstances` is configured below) announces itself to the Control Plane
 * so other Zanix Apps can reach it via `ctx.remote()`. Distinct from `mod.ts`, which only exports
 * the manifest — a host embedding this app instead never runs this file at all.
 *
 * See `@zanix/app`'s own README ("Standalone remote deployment") for `bootstrapRemoteApp`'s full
 * options and how graceful shutdown (`SIGINT`/`SIGTERM`) works here.
 */
await bootstrapRemoteApp(app, {
  // `rest` is only a DEFAULT — replace with whichever `WebServerTypes` this app actually serves
  // (`graphql`/`socket`/`ssr` are equally valid here; `ssr` in particular is untested for a Zanix
  // App specifically, since @zanix/app never exercises it — verify before relying on it).
  server: { rest: {} },
  // remoteInstances: { endpoint: 'http://my-app:8000' }, // uncomment to announce to the Control Plane
})
