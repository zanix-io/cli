# Generated by `zanix prepare --docker`. Destination-agnostic packaging — this is one option among
# several (see deploy.md); the real deploy artifact is always this project's own
# `${ENTRYPOINT_MODULE}` + the `start` task already declared in its `deno.json`.
#
# GET /health and /ready are served automatically by `@zanix/server`'s `bootstrapServers` — see
# deploy.md's "Health checks" section for probe examples (K8s httpGet, Docker HEALTHCHECK).

# ---- Build stage: install real npm deps (Vite/React/Tailwind/sharp) and build the client ----
FROM denoland/deno:${DENO_VERSION} AS build
WORKDIR /app
ENV DENO_DIR=/deno-dir

# ffmpeg/ffprobe — needed HERE, in the BUILD stage, if this project configures `mediaPlugin`'s own
# `optimize` (video breakpoints/thumbnails) for real, static files under `assetsDir`: `zanix space
# build` (the very next `RUN` below) runs `mediaPlugin`'s own `buildStart` in THIS process, so the
# binary must already be on PATH here — the runtime stage's own copy (below) is a SEPARATE
# provisioning target and never reaches back to this one. Harmless, unused weight for a project
# that never configures video optimization (or has no video assets at all) — same "install once,
# pay nothing if unused" reasoning the runtime stage's own copy already documents. See this
# Dockerfile's OWN runtime-stage copy below for the full capability-check rationale (identical
# check, duplicated deliberately — see that comment for why a shared base-image approach wasn't
# used instead).
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg \
  && rm -rf /var/lib/apt/lists/* \
  && command -v ffmpeg > /dev/null \
  && command -v ffprobe > /dev/null \
  && for encoder in libx264 aac libvpx-vp9 libopus libwebp; do \
    ffmpeg -hide_banner -encoders 2>/dev/null | grep -q "$encoder" \
      || (echo "FATAL: this image's ffmpeg build is missing the '$encoder' encoder — @zanix/space's own VideoTranscoder contract requires it" >&2 && exit 1); \
  done

COPY deno.json* deno.lock* ./
RUN deno install

COPY . .
# The `zanix` binary itself is NOT on PATH in this (or any fresh `denoland/deno`) base image —
# installed here, once, so `deno task build` below (this project's own `zanix space build` task —
# see `baseZnxConfig`'s own `tasks.build`) actually resolves. This is the SAME install command this
# package's own README documents for a real developer machine, not a Docker-specific variant.
RUN deno install -A -g -n zanix jsr:@zanix/cli
# `deno task build`, not a second, independently-maintained `deno run -A jsr:@zanix/cli space
# build` invocation — one declared build step a project's own `deno.json` already owns, so a flag
# added to the task (`--out-dir`, `--obfuscate`, ...) never has to be remembered here too.
RUN deno task build

# ---- Runtime stage ----
FROM denoland/deno:${DENO_VERSION}
WORKDIR /app
ENV DENO_DIR=/deno-dir

# ffmpeg/ffprobe — only exercised if this app's own code calls @zanix/space's VideoTranscoder
# (video transcoding), AT RUNTIME, against whatever file/asset it's given; harmless, unused weight
# otherwise. @zanix/space never installs either binary itself, never bundles them as a JS/npm
# dependency (see deploy.md's "Media transcoding" section) — this Dockerfile is the one place in
# the Zanix toolchain that actually PROVISIONS them, for the one target (Docker) that owns its own
# base image. Installed before COPY so an app code change never invalidates this layer's cache.
#
# **This is a SEPARATE stage from the build one above, on purpose — never merged into one shared
# base/layer.** The two-stage split's whole point (a real npm-deps/build toolchain never shipping
# in the final runtime image) is unrelated to ffmpeg specifically, but re-deriving the runtime
# stage FROM the build stage (instead of a fresh `denoland/deno:${DENO_VERSION}`) would drag every
# Vite/npm build dependency along with it — a real regression this duplication avoids. The two
# copies of this exact `RUN` block are intentionally identical, not a maintenance hazard in
# practice: both pin the SAME `${DENO_VERSION}`-derived base image, so both always resolve the
# same `apt-get install ffmpeg` build.
#
# The capability check right after is NOT optional/best-effort — it fails the DOCKER BUILD itself
# (never silently produces a broken image) if either binary isn't really on PATH, or if any
# capability @zanix/space's own contract actually guarantees is missing:
# - `libx264`/`aac`/`libvpx-vp9`/`libopus` — the baseline `REQUIRED_ENCODERS`
#   (`modules/media/ffmpeg-availability.ts`) `transcode()` itself depends on for every call; without
#   them the whole transcoder reports `available: false` at runtime, for every request, silently.
# - `libwebp` — required specifically for `extractThumbnail({ format: 'webp' })`, guaranteed by
#   @zanix/space's own thumbnail contract (same module's own `capabilities.webpEncoder` doc).
# Confirmed empirically: this base image's `apt-get install ffmpeg` (Debian trixie) already ships a
# build with all five. This assertion turns a silent, future loss of that guarantee (e.g. a base
# image bump landing on a Debian release/package build that drops one of them) into a loud,
# immediate BUILD failure here, instead of a runtime surprise deep inside a request handler.
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg \
  && rm -rf /var/lib/apt/lists/* \
  && command -v ffmpeg > /dev/null \
  && command -v ffprobe > /dev/null \
  && for encoder in libx264 aac libvpx-vp9 libopus libwebp; do \
    ffmpeg -hide_banner -encoders 2>/dev/null | grep -q "$encoder" \
      || (echo "FATAL: this image's ffmpeg build is missing the '$encoder' encoder — @zanix/space's own VideoTranscoder contract requires it" >&2 && exit 1); \
  done

# Only what production `deno run ${ENTRYPOINT_MODULE}` actually reads — never a blanket `COPY . .`.
# `@zanix/space` runs its SSR side directly against source (no server-side bundle: a page/Comet's
# own `.tsx` is `import()`-ed by its real path at request time), so `src/` ships raw. Everything
# else here is either config `deno run` needs (bare-specifier import map, lockfile verification —
# the `${TASK_NAME}` task never passes `--no-lock`) or the compiled client output from the build
# stage below.
#
# Deliberately NOT copied, because production never reads any of it:
# - `theme/` — build-time-only source for `globalCss`. The runtime reads
#   `${CLIENT_BUILD_DIR}/css-manifest.json` and the already-hashed CSS under
#   `${CLIENT_BUILD_DIR}/assets/` instead (`resolveCssHrefs()`, gated on the same
#   `!isDevClientEnabled()` this image always satisfies).
# - `messages/` (raw `messagesDir` source) — once `clientBuildDir` is configured (as this image's
#   own `${CLIENT_BUILD_DIR}` build step requires), `loadMessages()` reads
#   `${CLIENT_BUILD_DIR}/messages/...` exclusively; the hand-authored ICU source is never touched
#   in production.
# - `assets/` (raw `assetsDir` source) — `zanix space build`'s own `assetsPlugin` already emits
#   EVERY file under it into `${CLIENT_BUILD_DIR}/assets/` (`AssetsRoute.serve()` tries that build
#   output FIRST, before ever falling back to a raw copy this Dockerfile doesn't ship) — copying
#   the raw folder too would be a straight duplicate of what `${CLIENT_BUILD_DIR}` below already
#   carries, AND fails the build outright for the common case (a project whose `assetsDir` is
#   unset, or an empty placeholder — `COPY` has no "skip if missing" mode, unlike a shell `cp`
#   with a guard). Only add a real `COPY assets ./assets` line back if this project's OWN code
#   references a stable/hardcoded asset path that deliberately bypasses `resolveAssetHref()` (rare
#   — most apps never do this).
# - `docs/`, `README.md`, `CHANGELOG.md`, `LICENSE`, `src/@tests/` — never imported by any runtime
#   code path.
COPY deno.json* deno.jsonc* deno.lock* ${ENTRYPOINT_MODULE} space.app.ts ./
COPY src ./src
COPY --from=build /deno-dir /deno-dir
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/${CLIENT_BUILD_DIR} ./${CLIENT_BUILD_DIR}

EXPOSE ${PORT}

CMD ["task", "start"]
