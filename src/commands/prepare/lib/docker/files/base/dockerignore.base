# Version control
.git/
.github/

# Editor & system files
.DS_Store
.vscode/
Thumbs.db

# Env files — never bake secrets into an image; pass them at `docker run`/orchestrator level
.env
.env.local
.env.*

# Local dependency cache — reinstalled inside the image by its own build stage, not copied in
node_modules/

# Build artifacts — regenerated by the image's own build stage, not copied in from the host
/dist/
/.dist/
/out/
.vite/
**/.vite/
dist-ssr/
**/*.module.css.d.ts

# Logs, temp files, coverage
*.log
*.tmp
__tmp__/
/.logs/
/coverage/
coverage.lcov
tsconfig.tsbuildinfo

# This packaging itself — never needed inside the image
Dockerfile
.dockerignore
